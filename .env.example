# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://krishi:krishi@localhost:5433/krishi
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_HOUR=20


# Answering LLM (from Day 2). Provider: anthropic | openai_compatible
# Examples for openai_compatible:
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY can be any text)
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Judge LLM for evaluation (same options as above)
JUDGE_PROVIDER=openai_compatible
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Production only (docker-compose.prod.yml)
DOMAIN=
POSTGRES_PASSWORD=

    {
      "id": "hf25",
      "type": "factual",
      "latency_ms": 24089.623399981065,
      "answer": "\u0939\u093e\u0901, \u091b\u093f\u0921\u093c\u0915\u093e\u0935 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964\u202f\u0915\u094b\u0915\u094b\u0928\u091f\u202f\u090f\u0930\u093f\u092f\u094b\u092b\u093c\u093e\u0907\u0921\u202f\u092e\u093e\u0907\u091f (\u091c\u094b \u0938\u0941\u092a\u093e\u0930\u0940\u202f\u0915\u0947\u202f\u092c\u091f\u0928\u094b\u0902\u202f\u092e\u0947\u0902 \u092d\u0940 \u0932\u0917\u0924\u0940 \u0939\u0948) \u0915\u0947 \u0932\u093f\u090f 2\u202f% \u0928\u0940\u092e \u0924\u0947\u0932\u202f+\u202f\u0932\u0939\u0938\u0941\u0928\u202f\u0907\u092e\u0932\u094d\u0936\u0928 \u092f\u093e \u0928\u0940\u092e\u202f\u092b\u093c\u0949\u0930\u094d\u092e\u0941\u0932\u0947\u0936\u0928 (\u0905\u091c\u093c\u0940\u0930\u093e\u091a\u091f\u093f\u0928\u202f0.004\u202f%) \u092f\u093e 0.4\u202f% \u0938\u0942\u0915\u094d\u0937\u094d\u092e\u202f\u0938\u0932\u094d\u092b\u093c\u0930 \u0915\u093e \u091b\u093f\u0921\u093c\u0915\u093e\u0935 \u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0939\u0948\u0964\u202f\u0938\u094d\u092a\u094d\u0930\u0947 \u0915\u094b \u0926\u0942\u0938\u0930\u0947 \u0938\u0947 \u0938\u093e\u0924\u0935\u0947\u0902 \u092c\u0902\u091b \u0924\u0915, \u0935\u093f\u0936\u0947\u0937\u0915\u0930 \u0924\u0940\u0938\u0930\u0947\u2011\u092a\u093e\u0901\u091a\u0935\u0947 \u092c\u0902\u091b \u092e\u0947\u0902 \u092a\u0930\u093f\u0910\u0928\u094d\u0925 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u093e\u0928\u0947 \u091a\u093e\u0939\u093f\u090f\u0964\u202f\u0930\u0949\u0915\u0930\u202f\u0938\u094d\u092a\u094d\u0930\u0947\u092f\u0930\u202f\u0938\u0947\u202f1.0\u20111.5\u202f\u0932\u0940\u091f\u0930\u202f\u0938\u094d\u092a\u094d\u0930\u0947\u202f\u0926\u094d\u0930\u0935\u202f\u092a\u094d\u0930\u0924\u093f\u202f\u092a\u093e\u092e, \u0939\u093e\u0925\u202f\u0938\u094d\u092a\u094d\u0930\u0947\u092f\u0930\u202f\u0938\u0947\u202f500\u2011750\u202f\u092e\u093f\u0932\u0940\u0932\u0940\u091f\u0930\u202f\u0932\u0917\u093e\u090f\u0901\u0964\u202f\u0935\u0930\u094d\u0937 \u092e\u0947\u0902 \u0924\u0940\u0928 \u092c\u093e\u0930 \u091b\u093f\u0921\u093c\u0915\u093e\u0935 \u0915\u0930\u0947\u0902 \u2013 \u092e\u093e\u0930\u094d\u091a\u2011\u0905\u092a\u094d\u0930\u0948\u0932, \u0905\u0917\u0938\u094d\u0924\u2011\u0938\u093f\u0924\u0902\u092c\u0930 \u0914\u0930 \u0926\u093f\u0938\u0902\u092c\u0930\u2011\u091c\u0928\u0935\u0930\u0940\u202f[1][3]\u0964 \n\n\u092f\u0926\u093f \u0906\u092a \u0928\u0940\u092e\u202f\u0924\u0947\u0932\u202f+\u202f\u0932\u0939\u0938\u0941\u0928\u202f\u0907\u092e\u0932\u094d\u0936\u0928 \u092c\u0928\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b 10\u202f\u0932\u0940\u091f\u0930\u202f\u0915\u0947 \u0932\u093f\u092f\u0947 200\u202f\u092e\u093f\u0932\u0940\u0932\u0940\u091f\u0930\u202f\u0928\u0940\u092e \u0924\u0947\u0932, 200\u202f\u0917\u094d\u0930\u093e\u092e\u202f\u0932\u0939\u0938\u0941\u0928, 50\u202f\u0917\u094d\u0930\u093e\u092e\u202f\u092c\u093e\u0930\u202f\u0938\u094b\u092a \u0914\u0930 9\u202f\u0932\u0940\u091f\u0930\u202f\u092a\u093e\u0928\u0940 \u092e\u093f\u0932\u093e\u090f\u0901\u202f[3]\u0964 \n\n\u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u091b\u093f\u0921\u093c\u0915\u093e\u0935 \u0915\u0930\u0915\u0947 \u092e\u093e\u0907\u091f \u0915\u094b \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
